# ÍTEM 1: Carga manual de datos 
def cargar_datos(legajos, nombres, generos, parciales1, parciales2):
    """Funcion que sirve para cargar todos los datos de un estudiante. Si todos los datos son validados correctamente,
    se guardan en listas con su nombre
    Args: legajos, nombres, generos, parciales1, parciales2""" 

    print(f"Iniciando carga manual de {MAX_ALUMNOS} estudiantes")
    for i in range(MAX_ALUMNOS):
        #Cuenta desde el 0 al 29
        print(f"Estudiante {i + 1}:")
        legajos[i] = validar_legajo()
        nombres[i] = validar_nombre()
        generos[i] = validar_genero()
        parciales1[i] = validar_nota("Nota del Primer Parcial (1-10): ")
        parciales2[i] = validar_nota("Nota del Segundo Parcial (1-10): ")
    print("Carga de datos finalizada con éxito.")


# ÍTEM 2: Mostrar un elemento
def mostrar_un_elemento(legajo, nombre, genero, p1, p2, promedio=None):
    """Funcion que se encarga mostrar los datos de cada estudiante (legajo, nombre, genero, p1, p2 y promedio). El promedio
    se muestra unicamente si se calculo previamente (opcion 3)
