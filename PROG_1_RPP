# ÍTEM 2b: Recorrer (Nota 6 - Una llama a la otra)
def recorrer_y_mostrar(legajos, nombres, generos, parciales1, parciales2, promedios):
    """Funcion que recorre las listas que guardan los datos de los estudiantes y corrobora si hay datos cargados en 
    estas para mostrarlos
    Args: legajos, nombres, generos, parciales1, parciales2, promedios"""

    print("REPORTE GENERAL DE ESTUDIANTES")
    for i in range(len(legajos)):
        if legajos[i] is None:
            break  
        
        prom = promedios[i]
        mostrar_un_elemento(legajos[i], nombres[i], generos[i], parciales1[i], parciales2[i], prom)


# ÍTEM 3: Calcular promedios
def calcular_promedio(legajos, parciales1, parciales2, promedios):
    """Funcion que calcula el promedio de cada estudiante, siempre que se hayan cargado los datos de estos mismos.
    Para calcularlo, hace la suma las dos notas divido la cantidad de parciales.
    Args: legajos, paricales1, parciales2, promedios"""

    for i in range(len(parciales1)):
        if legajos[i] is None:
            break
        else:
            promedios[i] = (parciales1[i] + parciales2[i]) / 2.0
    print("Promedios calculados y guardados exitosamente.")


# ÍTEM 4: Ordenar por promedio (Algoritmo Bubble Sort indexado)
def ordenar_por_promedio(legajos, nombres, generos, parciales1, parciales2, promedios, criterio= "DESC"): 
    """Funcion que se encarga de ordenar los promedios cargados en orden DESCENDENTE, junto con el resto de datos
    de los estudiantes. Ordena primero los datos del alumno de mejor promedio y deja al final los del peor promedio
    Args: legajos, nombres, generos, parciales1, parciales2, promedios, criterio"""
    
    numero_alumnos = 0
    for elemento in legajos:
        if elemento is not None:
            numero_alumnos += 1

    for i in range(numero_alumnos - 1): 
        for j in range(numero_alumnos - 1 - i): 
            debe_intercambiar = False                                  
            if criterio == "DESC" and promedios[j] < promedios[j + 1]:
                debe_intercambiar = True    

            if debe_intercambiar:
                promedios[j], promedios[j + 1] = promedios[j + 1], promedios[j] #
                                                                                
                legajos[j], legajos[j + 1] = legajos[j + 1], legajos[j]
                nombres[j], nombres[j + 1] = nombres[j + 1], nombres[j]
                generos[j], generos[j + 1] = generos[j + 1], generos[j]
                parciales1[j], parciales1[j + 1] = parciales1[j + 1], parciales1[j]
                parciales2[j], parciales2[j + 1] = parciales2[j + 1], parciales2[j]
    

# ÍTEM 5: Mostrar mejores promedios (funciones del Ítem 2) 
def mostrar_mejores_promedios(legajos, nombres, generos, parciales1, parciales2, promedios):
    """Funcion que muestra los mejores promedios cargados de estudiantes, junto con el resto de datos de 
    estos mismos 
    Args: legajos, nombres, generos, parciales1, parciales2, promedios
    Return: None: Si la lista legajos esta vacia (no se cargaro ningun dato)"""

    if legajos[0] is None:
        return None
    
    mayor_promedio = promedios[0]
    for i in range(len(promedios)):
        if legajos[i] is None:
            break
        if promedios[i] > mayor_promedio:
            mayor_promedio = promedios[i]
            
    print(f"Estudiante(s) con el Mayor Promedio ({mayor_promedio})") 
    for i in range(len(promedios)):
        if legajos[i] is None:
            break
        if promedios[i] == mayor_promedio: 
            mostrar_un_elemento(legajos[i], nombres[i], generos[i], parciales1[i], parciales2[i], promedios[i])


# ÍTEM 6: Buscar por legajo (funciones del Ítem 2)
def buscar_por_legajo(legajos, nombres, generos, parciales1, parciales2, promedios):
    """Funcion que realiza la busqueda de un estudiante por legajo para ver sus datos. Si el legajo ingresado esta dentro
    de los legajos que se cargaron, entonces muestra los datos del estudiante
    Args: legajos, nombres, generos, parciales1, parciales2, promedios"""

    print("Búsqueda de Estudiante")
    buscado = validar_legajo()
    encontrado = False
    
    for i in range(len(legajos)):
        if legajos[i] is None:
            break
        if legajos[i] == buscado:
            print("Estudiante encontrado:")
            mostrar_un_elemento(legajos[i], nombres[i], generos[i], parciales1[i], parciales2[i], promedios[i])
            encontrado = True
            break
            
    if not encontrado:
        print(f"No se encontró ningún estudiante con el legajo {buscado}.")


